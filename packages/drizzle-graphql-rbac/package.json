{
  "name": "drizzle-graphql-rbac",
  "version": "0.1.0",
  "description": "Auto-generated GraphQL + REST auth + Odoo-style RBAC for Drizzle ORM apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tables": "./src/tables.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts src/auth/*.test.ts src/admin/*.test.ts src/graphql/builder/*.test.ts src/graphql/rbac/*.test.ts src/graphql/domain/*.test.ts"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11",
    "drizzle-orm": ">=0.36",
    "graphql": ">=16",
    "graphql-yoga": ">=5",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "@node-rs/argon2": "^2.0.2",
    "hono-rate-limiter": "^0.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.4",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
